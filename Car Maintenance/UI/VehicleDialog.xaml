<Window x:Class="CarMaintenance.UI.VehicleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add vehicle" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}" Background="White"
        FocusManager.FocusedElement="{Binding ElementName=MakeBox}">
    <StackPanel>
        <StackPanel Margin="28,24,28,8">
            <TextBlock Text="Add a vehicle" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Enter the details of the car you want to track." Style="{StaticResource Muted}" FontSize="13"
                       Margin="0,4,0,6" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Make" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="MakeBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Model" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ModelBox" />
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Year" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="YearBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="License plate" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="PlateBox" CharacterCasing="Upper" FontFamily="Consolas" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Current mileage (km)" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="MileageBox" />

            <Border x:Name="ErrorBox" Background="{StaticResource DangerSoft}" CornerRadius="8" Padding="12,8"
                    Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Border Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                Padding="28,14" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True" MinWidth="90" />
                <Button Style="{StaticResource PrimaryButton}" Content="Add vehicle" IsDefault="True" MinWidth="110"
                        Margin="10,0,0,0" Click="Save_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
