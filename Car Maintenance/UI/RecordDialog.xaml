<Window x:Class="CarMaintenance.UI.RecordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add service" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}" Background="White">
    <StackPanel>
        <StackPanel Margin="28,24,28,8">
            <TextBlock Text="Log a service" FontSize="20" FontWeight="Bold" />
            <TextBlock x:Name="VehicleLabel" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,6" />

            <TextBlock Text="Type of service" Style="{StaticResource FieldLabel}" />
            <!-- Service type chips: click one to select it -->
            <ListBox x:Name="TypeBox" BorderThickness="0" Background="Transparent" Margin="-3,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Once">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="3" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="16" Padding="12,6" BorderThickness="2"
                                            Background="{Binding Back}" BorderBrush="Transparent" Opacity="0.75">
                                        <TextBlock Foreground="{Binding Fore}" FontWeight="SemiBold" FontSize="13">
                                            <Run Text="{Binding Icon, Mode=OneWay}" />
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="1" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="1" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding Fore}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                    <DatePicker x:Name="DateBox" SelectedDateFormat="Short" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Mileage (km)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="MileageBox" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Cost" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="CostBox" />

            <TextBlock Text="Notes (optional)" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NotesBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" />

            <Border x:Name="ErrorBox" Background="{StaticResource DangerSoft}" CornerRadius="8" Padding="12,8"
                    Margin="0,16,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Border Background="#F8FAFC" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                Padding="28,14" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancel" IsCancel="True" MinWidth="90" />
                <Button Style="{StaticResource PrimaryButton}" Content="Save service" IsDefault="True" MinWidth="110"
                        Margin="10,0,0,0" Click="Save_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
